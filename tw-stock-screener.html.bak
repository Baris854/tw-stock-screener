<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>台股選股｜公開資料篩選器</title>
<style>
:root{--bg:#f4f6f8;--ink:#19232d;--muted:#73808c;--line:#e5e9ed;--blue:#245bdb;--green:#087f5b;--card:#fff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans TC",sans-serif}.wrap{max-width:1180px;margin:auto;padding:34px 24px 60px}.top{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:26px}.eyebrow{font-size:12px;letter-spacing:.1em;color:var(--blue);font-weight:700}.top h1{font-size:30px;letter-spacing:-.04em;margin:5px 0}.top p{margin:0;color:var(--muted)}button{border:0;background:var(--blue);color:#fff;border-radius:9px;padding:11px 16px;font:inherit;font-weight:650;cursor:pointer}button:disabled{opacity:.55;cursor:wait}.layout{display:grid;grid-template-columns:270px 1fr;gap:18px}.panel,.results{background:var(--card);border:1px solid var(--line);border-radius:14px}.panel{padding:20px;height:max-content}.panel h2{font-size:16px;margin:0 0 17px}.field{margin:15px 0}.field label{display:flex;justify-content:space-between;font-size:13px;font-weight:650;margin-bottom:7px}.field small{color:var(--muted);font-weight:400}input{width:100%;border:1px solid #dce2e8;border-radius:8px;padding:10px 11px;font:inherit;outline:none}input:focus{border-color:var(--blue);box-shadow:0 0 0 3px #245bdb1c}.hint{background:#f4f7ff;color:#40516b;padding:11px;border-radius:8px;font-size:12px;margin-top:18px}.summary{display:flex;gap:10px;margin-bottom:14px}.stat{padding:13px 16px;background:#fff;border:1px solid var(--line);border-radius:11px;flex:1}.stat small{display:block;color:var(--muted);font-size:12px}.stat strong{font-size:20px}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-bottom:1px solid var(--line)}.toolbar input{max-width:250px}.meta{font-size:12px;color:var(--muted)}.tablewrap{overflow:auto;max-height:66vh}table{width:100%;border-collapse:collapse;white-space:nowrap}th,td{text-align:right;padding:12px 16px;border-bottom:1px solid #eef0f2}th{position:sticky;top:0;background:#fbfcfd;color:#697581;font-size:12px;font-weight:650}th:first-child,td:first-child{text-align:left}tbody tr:hover{background:#f8faff}.ticker{font-weight:700}.name{color:#65717d;margin-left:7px}.good{color:var(--green);font-weight:650}.empty{text-align:center!important;color:var(--muted);padding:36px}.status{padding:11px 16px;color:var(--muted);font-size:12px;border-top:1px solid var(--line)}.status.error{color:#b42318}.status a,.hint a{color:var(--blue)}@media(max-width:760px){.wrap{padding:22px 14px}.top{align-items:flex-start}.top h1{font-size:24px}.layout{grid-template-columns:1fr}.summary{flex-wrap:wrap}.stat{min-width:42%}.tablewrap{max-height:none}}
</style>
</head>
<body><main class="wrap">
<header class="top"><div><div class="eyebrow">TAIWAN EQUITY DATA</div><h1>台股公開資料篩選器</h1><p>用估值與殖利率條件，快速縮小上市股票觀察清單。</p></div><button id="refresh">↻ 更新資料</button></header>
<div class="layout"><aside class="panel"><h2>篩選條件</h2>
<div class="field"><label for="psr">PSR 上限 <small>倍</small></label><input id="psr" type="number" min="0" step="0.1" placeholder="不限"></div>
<div class="field"><label for="pe">PER（本益比）上限 <small>倍</small></label><input id="pe" type="number" min="0" step="1" placeholder="不限"></div>
<div class="field"><label for="pb">PBR（股價淨值比）上限 <small>倍</small></label><input id="pb" type="number" min="0" step="0.1" placeholder="不限"></div>
<div class="field"><label for="graham">Graham index 上限 <small>PER × PBR</small></label><input id="graham" type="number" min="0" step="0.5" placeholder="不限"></div>
<div class="field"><label for="yield">殖利率下限 <small>%</small></label><input id="yield" type="number" min="0" step="0.5" placeholder="不限"></div>
<div class="hint"><strong>參考算法與使用說明</strong><br>策略分類：PSR（週期價值）、PER／PBR（收益價值）、Graham index（資產價值）。PSR = 市值 ÷（最近月營收 × 12），屬年化估算，非正式 TTM。Graham index = PER × PBR，常見參考線為 22.5。可自行輸入上限；留白表示不套用。<br><br>公開書目未列出該書門檻，這裡採常見公式供參考，並非宣稱是作者原文。資料涵蓋<strong>上市股票</strong>，非逐筆即時報價或投資建議。<br><br><a href="https://openapi.twse.com.tw/" target="_blank" rel="noreferrer">查看官方 API 文件 ↗</a></div>
</aside><section><div class="summary"><div class="stat"><small>符合條件</small><strong id="count">—</strong></div><div class="stat"><small>資料日期</small><strong id="date">—</strong></div><div class="stat"><small>資料來源</small><strong style="font-size:15px">TWSE OpenAPI</strong></div></div>
<div class="results"><div class="toolbar"><strong>篩選結果</strong><input id="search" type="search" placeholder="搜尋代號或公司名稱"></div><div class="tablewrap"><table><thead><tr><th>股票</th><th>PSR*</th><th>PER</th><th>PBR</th><th>Graham index</th><th>殖利率</th></tr></thead><tbody id="rows"><tr><td colspan="6" class="empty">按「更新資料」載入官方資料</td></tr></tbody></table></div><div id="status" class="status">等待載入</div></div></section></div></main>
<script>
const API='/api/stocks';let stocks=[];
const $=id=>document.getElementById(id);const num=v=>{if(v===null||v===undefined||String(v).trim()==='')return null;const n=Number(String(v).replaceAll(',',''));return Number.isFinite(n)?n:null};
function render(){const q=$('search').value.trim().toLowerCase(),psr=num($('psr').value),pe=num($('pe').value),pb=num($('pb').value),graham=num($('graham').value),dy=num($('yield').value);const items=stocks.filter(s=>{const match=`${s.Code} ${s.Name}`.toLowerCase().includes(q);return match&&(psr===null||s.psr!==null&&s.psr<=psr)&&(pe===null||s.pe!==null&&s.pe<=pe)&&(pb===null||s.pb!==null&&s.pb<=pb)&&(graham===null||s.graham!==null&&s.graham<=graham)&&(dy===null||s.dy!==null&&s.dy>=dy)});$('count').textContent=items.length.toLocaleString();$('rows').innerHTML=items.length?items.map(s=>`<tr><td><span class="ticker">${s.Code}</span><span class="name">${s.Name}</span></td><td>${s.psr===null?'—':s.psr.toFixed(2)}</td><td>${s.pe===null?'—':s.pe.toFixed(2)}</td><td>${s.pb===null?'—':s.pb.toFixed(2)}</td><td>${s.graham===null?'—':s.graham.toFixed(2)}</td><td class="${s.dy!==null&&s.dy>=5?'good':''}">${s.dy===null?'—':s.dy.toFixed(2)+'%'}</td></tr>`).join(''):'<tr><td colspan="6" class="empty">沒有符合條件的股票</td></tr>'}
function taiwanDate(raw){if(!raw)return '—';const s=String(raw);if(s.length===7){const y=Number(s.slice(0,3))+1911;return `${y}/${s.slice(3,5)}/${s.slice(5,7)}`}return s}
async function load(){const b=$('refresh');b.disabled=true;$('status').className='status';$('status').textContent='正在向證交所載入估值、營收與股本資料…';try{const res=await fetch(API,{cache:'no-store'});if(!res.ok)throw new Error(`HTTP ${res.status}`);const data=await res.json();if(!Array.isArray(data))throw new Error(data.error||'API 回傳格式不是預期的清單');stocks=data.map(x=>({Code:x.Code,Name:x.Name,psr:num(x.PSR),pe:num(x.PEratio),dy:num(x.DividendYield),pb:num(x.PBratio),graham:num(x.GrahamIndex),date:x.Date}));const d=data.find(x=>x.Date)?.Date;$('date').textContent=taiwanDate(d);render();const missing=(res.headers.get('X-Data-Warnings')||'').split(',').filter(Boolean);$('status').innerHTML=`已載入 ${stocks.length.toLocaleString()} 筆估值資料；PSR 為最新月營收年化估算。${missing.length?`PSR 參考資料暫缺：${missing.join('、')}。`:''}來源：<a href=\"https://openapi.twse.com.tw/\" target=\"_blank\" rel=\"noreferrer\">證交所官方 OpenAPI</a>。按更新可重新抓取。`}catch(e){$('status').className='status error';$('status').textContent=`載入失敗：${e.message}。請確認本機資料服務已啟動，並透過 http://127.0.0.1:8765 開啟本頁。`}finally{b.disabled=false}}
['psr','pe','pb','graham','yield','search'].forEach(id=>$(id).addEventListener('input',render));$('refresh').addEventListener('click',load);load();
</script></body></html>
